# Supply Chain Security & Dependency Hardening

# Block preinstall, install, and postinstall lifecycle scripts
ignore-scripts=true
enable-pre-post-scripts=false

# Minimum package release age cooldown buffer (prevents zero-day malicious package injection)
# 1440 minutes = 24 hours
min-release-age=1
minimum-release-age=1440

# Prevent transitive dependencies from using remote git or arbitrary tarball URLs
block-exotic-subdeps=true

# Strict engine compliance
engine-strict=true

# Only allow explicitly declared native builds if required
strict-dep-builds=true
